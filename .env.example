# API
PORT=3001
AGENT_DATA_DIR=.agentstack/dev-profiles/greenhouse/data
DEPLOYMENT_ID=dep-gh-pilot-001
ACTIVE_DOMAIN=agriculture
MQTT_URL=mqtt://127.0.0.1:1883
# Stack TLS：先运行 scripts/mosquitto-gen-certs.sh，再改为 mqtts://127.0.0.1:8883
# MQTT_REJECT_UNAUTHORIZED=0
# MQTT_CA_FILE=infra/mosquitto/certs/ca.crt
# MQTT_USERNAME=node
# MQTT_PASSWORD=
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# 状态后端（file | redis）
STATE_BACKEND=file
# STATE_BACKEND=redis 时必须显式配置；Compose stack 内通常为 redis://redis:6379
# REDIS_URL=
# REDIS_LOCK_TTL_MS=120000
COMMAND_STORE=file
# COMMAND_STORE=sqlite 时未设置则默认 {AGENT_DATA_DIR}/agent.db
# SQLITE_PATH=

# LLM（也可在 Web 配置台写入 AGENT_DATA_DIR/settings.json）
# LLM_PROVIDER=deepseek|openai
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
# 思考模式默认开启；设 0 关闭。Web 配置台 settings.json 优先于本文件。
LLM_THINKING=1
# OpenAI 语音转写（provider=openai 时）
STT_PROVIDER=none
STT_MODEL=whisper-1
# STT_API_KEY=
# STT_APP_KEY=
# STT_APP_ID=

# 管理 / 集成
ADMIN_TOKEN=dev-admin
# Web 工作台 session（生产必填；开发/测试有 dev 默认）
# SESSION_SECRET=
# 首次部署兑换首个 admin（一次性）
# WEB_INSTALL_CODE=
INTEGRATION_SECRET=
DEV_CHAT_SECRET=
# 生产默认关闭 /dev/chat；临时排障可显式开启
# ENABLE_DEV_CHAT=1

# 模拟器（node-simulator）
NODE_ID=node-sim-gh-001
GREENHOUSE_ID=gh-001
SIM_MAX_COMMAND_MS=0
# domain:flywheel agriculture adapter 会设置 full + react
SIM_TELEMETRY_SCENARIO=
SIM_TELEMETRY_REACT=
ENSURE_SIM_DUAL_FORCE_REBIND=

# 场景飞轮 / L3
FLYWHEEL_DEV=
SUSTAINED_L2_COOLDOWN_SECONDS=
DEVICE_HEARTBEAT_TIMEOUT_MS=90000
SCENE_OUTCOME_WINDOWS_MINUTES=15

# CHAT_CHANNEL=wechat-stub

# 通知与表达（也可在 Web 配置台「通知与表达层」保存到 settings.json）
# ALERT_PUSH_ENABLED=0
# DIGEST_ENABLED=0
# WEATHER_PROACTIVE_ENABLED=0
# NLG_ENABLED=0
# nlg_flash_enabled 仅通过配置台 / settings.json 配置；默认 false

# Stack MQTT（docker compose --profile stack；本地 aedes 无需配置）
# MQTT_API_PASSWORD=
# MQTT_NODE_PASSWORD=
# 生成证书后 stack 端到端 TLS：MQTT_URL=mqtts://mosquitto:8883 MQTT_REJECT_UNAUTHORIZED=0

# 生产 settings 密钥静态加密（AES-256-GCM，写入 eaenc:v1: 前缀）
# AGENT_SECRETS_KEY=

# 生产 metrics（二选一）：推荐 scrape token（openssl rand -hex 32）；或显式允许公开（仅网络隔离 / CI）
# METRICS_SCRAPE_TOKEN=
# METRICS_ALLOW_PUBLIC=1

# 匿名 demo 栈专用：生产语义下 DEMO_READONLY=1 必须同时 DEMO_STACK=1
# DEMO_READONLY=1
# DEMO_STACK=1

# 运行数据保留（天）；设置后 API 后台任务会周期性裁剪 JSONL
# RETENTION_DAYS=90

# Web（本地 dev 默认 token；生产 stack 须在配置台手输 ADMIN_TOKEN，勿写入前端 bundle）
VITE_ADMIN_TOKEN=dev-admin
VITE_API_PROXY=http://127.0.0.1:3001
VITE_WECHAT_CONTACT=
WEB_PORT=5173

# 意图飞轮 / 评测
INTENT_PROMOTE_MATRIX_TIMEOUT_MS=600000
INTENT_PROMOTE_WECHAT_API=0
FILE_LOCK_STALE_MS=

# 地理 / 卫星（P2）
GEO_LATITUDE=
GEO_LONGITUDE=
# SATELLITE_API_KEY=
