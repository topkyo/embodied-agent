# VPS 部署环境变量模板
# 用法：cp .env.vps.example .env.vps.local && 填入真实值
# 此文件安全提交到 Git；.env.vps.local 必须加入 .gitignore

# ─── 部署标识 ───
DEPLOYMENT_ID=dep-gh-pilot-001
ACTIVE_DOMAIN=agriculture

# ─── MQTT ───
# 本机部署 broker 走 loopback；MQTT_PASSWORD 用 API 凭据（= MQTT_API_PASSWORD 值）。
# 模拟器由 sim-entry.sh 覆盖为 node 凭据（MQTT_NODE_PASSWORD），无需在此改。
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=api
MQTT_PASSWORD=与MQTT_API_PASSWORD相同
MQTT_API_PASSWORD=请替换为强密码
MQTT_NODE_PASSWORD=请替换为另一个强密码
MQTT_REJECT_UNAUTHORIZED=1

# ─── 认证与安全 ───
ADMIN_TOKEN=请替换为32位以上随机字符串
SESSION_SECRET=请替换为64位以上随机字符串
AGENT_SECRETS_KEY=请替换为32位以上随机字符串
INTEGRATION_SECRET=

# ─── Web 安装与用户引导 ───
# bootstrap 流程用，首次创建管理员账户时需要。
# 格式自定义，如 EA-INSTALL-<随机hex>。
# 创建管理员后可删除（bootstrap 会被标记为已兑换）。
WEB_INSTALL_CODE=EA-INSTALL-替换为随机码

# ─── CORS ───
# 精确列出所有前端域名（逗号分隔），无通配符
# Vercel 子域名 + Tunnel URL
CORS_ORIGIN=https://ea-web-XXXX.vercel.app,https://ea-site-XXXX.vercel.app,https://your-tunnel-url.trycloudflare.com

# ─── LLM ───
LLM_PROVIDER=deepseek
LLM_API_KEY=填入真实API Key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_THINKING=1

# ─── 运行时 ───
# NODE_ENV 必须显式 production（未设置/空串按生产 fail-closed，但显式更清晰）。
NODE_ENV=production
PORT=3001
# 生产默认仅本机（见 bootstrap.ts）；显式写出避免误暴露
HOST=127.0.0.1
STATE_BACKEND=file
COMMAND_STORE=file
AGENT_DATA_DIR=/home/tim/var/embodied-agent-data
# 生产 /metrics：须设 token（推荐）或仅在 scrape 已网络隔离时显式 METRICS_ALLOW_PUBLIC=1
# 生成：openssl rand -hex 32 ；scrape 用 Authorization: Bearer … 或 x-metrics-token: …
METRICS_SCRAPE_TOKEN=
# METRICS_ALLOW_PUBLIC=1

# ─── 模拟器（可选）───
# NODE_ID 由 ea-simulator@.service 模板注入（Environment=NODE_ID=%i），不在此设置。
# 启动实例：systemctl start ea-simulator@node-sim-gh-001 ea-simulator@node-sim-gh-002
SIM_TELEMETRY_REACT=1
