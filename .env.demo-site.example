# ===== demo 栈全局（docker-compose.demo.yml 真源；变量索引见 docs/operations/env-keys.zh.md §7.1）=====
# 用法：cp .env.demo-site.example .env.demo-site.local 后填入本地 secret
DEMO_STACK_NODE_ENV=development
DEMO_STACK_DATA_ROOT=.agentstack/demo-profiles
DEMO_STACK_STATE_ROOT=.agentstack/demo-services
DEMO_STACK_ADMIN_TOKEN=local-admin-token
DEMO_STACK_SESSION_SECRET=replace-with-64-hex-chars
DEMO_SIM_RHYTHM=5-10m
LLM_API_KEY=replace-with-llm-key
# DEMO_STACK_NODE_ENV=production 时必填
# AGENT_SECRETS_KEY=replace-with-32-byte-key

# ===== 三域 API / broker / 数据源端口 =====
DEMO_GREENHOUSE_API_PORT=3101
DEMO_ROBOT_API_PORT=3201
DEMO_INDUSTRIAL_API_PORT=3301
DEMO_GREENHOUSE_MQTT_PORT=1884
DEMO_ROBOT_MQTT_PORT=1885
DEMO_INDUSTRIAL_MQTT_PORT=1886
DEMO_M20_STUB_PORT=3209

# ===== site CORS（须与营销站实际源一致）=====
# site:dev 默认 :5170；生产反代示例 :8080 或 https://demo.example.com
DEMO_SITE_ORIGIN=http://127.0.0.1:5170