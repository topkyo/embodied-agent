{
  "name": "embodied-agent",
  "version": "0.11.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "scenes/*"
  ],
  "scripts": {
    "pretest": "bash scripts/maybe-ensure-workspace-runtime-build.sh",
    "test": "npm run test --workspaces --if-present",
    "lint": "bash scripts/maybe-ensure-workspace-runtime-build.sh && tsx scripts/check-web-domain-catalog-sync.ts && tsx scripts/check-intent-cheatsheet-sync.ts && tsx scripts/check-env-keys.ts && tsx scripts/check-package-license.ts && tsc -b --noEmit && eslint . --max-warnings=0 && tsx scripts/check-repo-layout.ts && tsx scripts/check-domain-docs.ts && tsx scripts/check-web-domain-catalog.ts && tsx scripts/check-domain-pack-contracts.ts && tsx scripts/check-wechat-bind-chain.ts && tsx scripts/check-web-dogfood-critical.ts && tsx scripts/check-doc-links.ts && npm run domain:check",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "e2e": "playwright test",
    "build": "bash scripts/maybe-ensure-workspace-runtime-build.sh && npm run build -w @embodied-agent/api && npm run build -w @embodied-agent/web && npm run build -w @embodied-agent/site",
    "build:vercel": "bash scripts/maybe-ensure-workspace-runtime-build.sh && tsx scripts/build-vercel-output.ts",
    "eval:intent": "tsx scripts/run-intent-eval.ts",
    "seed:local-web-users": "tsx scripts/seed-local-web-users.ts",
    "sim:matrix": "tsx scripts/simulate-user-matrix.ts",
    "sim:matrix:evidence": "tsx scripts/check-sim-matrix-evidence.ts",
    "domain:check": "bash scripts/maybe-ensure-workspace-runtime-build.sh && tsx scripts/check-domain-pack-readiness.ts",
    "domain:new": "tsx scripts/domain-new.ts",
    "codegen:web-catalog": "tsx scripts/codegen-web-domain-catalog.ts",
    "domain:chat-verify": "tsx scripts/domain-chat-verify.ts",
    "eval:intent:matrix": "tsx scripts/run-intent-eval-matrix.ts",
    "verify:chat": "tsx scripts/domain-chat-verify.ts --pack agriculture",
    "ensure:sim-tokens": "tsx scripts/ensure-sim-node-tokens.ts",
    "ensure:sim-dual": "tsx scripts/ensure-sim-dual-nodes.ts",
    "ensure:sim-industrial": "tsx scripts/ensure-sim-industrial.ts",
    "intent:failures:list": "tsx scripts/promote-intent-failures.ts --list",
    "intent:failures:promote": "tsx scripts/promote-intent-failures.ts",
    "intent:failures:export-wechat": "tsx scripts/export-wechat-matrix-to-repo.ts",
    "intent:flywheel": "tsx scripts/intent-flywheel.ts",
    "api:dev": "npm run dev -w @embodied-agent/api",
    "web:dev": "npm run dev -w @embodied-agent/web",
    "site:dev": "npm run dev -w @embodied-agent/site",
    "site:build": "npm run build -w @embodied-agent/site",
    "demo:stack:local": "bash scripts/demo-stack-local.sh",
    "acceptance:up": "bash scripts/acceptance-stack.sh start",
    "acceptance:stop": "bash scripts/acceptance-stack.sh stop",
    "acceptance:status": "bash scripts/acceptance-stack.sh status",
    "dev:greenhouse": "bash scripts/dev-up.sh greenhouse",
    "dev:robot": "bash scripts/dev-up.sh robot",
    "dev:industrial": "bash scripts/dev-up.sh industrial",
    "dev:stop": "bash scripts/dev-services.sh stop",
    "dev:status": "bash scripts/dev-services.sh status",
    "dev:logs": "bash scripts/dev-services.sh logs",
    "node-sim:dev": "AGENT_DATA_DIR=${AGENT_DATA_DIR:-.agentstack/dev-profiles/greenhouse/data} ADMIN_TOKEN=dev-admin tsx scripts/node-simulator.ts",
    "pair:e2e": "tsx scripts/node-pair-e2e.ts",
    "pair:full:e2e": "tsx scripts/node-pair-full-e2e.ts",
    "stack:up": "docker compose --profile stack up -d",
    "stack:down": "docker compose --profile stack down",
    "intent:failures:promote-wechat": "tsx scripts/promote-failure-cases.ts",
    "domain:l3-smoke": "tsx scripts/scene-l3-smoke.ts",
    "domain:flywheel": "tsx scripts/domain-flywheel.ts",
    "robot:stub": "tsx scripts/m20-stub.ts",
    "robot:m20:stub": "tsx scripts/robot-m20-smoke.ts",
    "robot:matrix": "bash scripts/robot-matrix.sh",
    "verify:strict": "bash scripts/verify-strict-gate.sh",
    "verify:pr-strict": "bash scripts/verify-pr-strict-gate.sh",
    "codegen:intent": "tsx scripts/codegen-intent-cheatsheet.ts",
    "repair:wechat-bindings": "tsx scripts/repair-wechat-platform-bindings.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.52.0",
    "@types/node": "^24.13.3",
    "esbuild": "^0.27.7",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript-eslint": "^8.33.0",
    "vercel": "^56.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
