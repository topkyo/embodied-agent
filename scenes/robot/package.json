{
  "name": "@embodied-agent/domain-robotics",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./m20/client": {
      "types": "./dist/m20/client.d.ts",
      "import": "./dist/m20/client.js"
    },
    "./admin-routes": {
      "types": "./dist/admin-routes.d.ts",
      "import": "./dist/admin-routes.js"
    },
    "./flywheel-adapter": {
      "types": "./dist/flywheel/adapter.d.ts",
      "import": "./dist/flywheel/adapter.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "build:bootstrap": "rm -rf dist && tsc -p tsconfig.bootstrap.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@embodied-agent/core": "0.0.1",
    "@embodied-agent/domain-sdk": "0.0.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.8"
  }
}
